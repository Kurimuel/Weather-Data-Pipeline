# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ
# ห้าม commit ไฟล์ .env ขึ้น GitHub เด็ดขาด (มี password อยู่ข้างใน)

# เอาค่านี้มาจาก Supabase > Project Settings > Database > Connection string
# postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
